@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<style>
    :root {
        --bg: #0a1020; --panel: #111a2e; --panel2: #0d1526; --line: #20304c;
        --txt: #e8eefb; --dim: #93a6c4; --acc: #ffc23c; --acc2: #57b6ff;
    }
    html, body, .mud-layout { background: var(--bg) !important; color: var(--txt); }
    .mud-paper {
        background: linear-gradient(180deg, var(--panel), var(--panel2)) !important;
        border: 1px solid var(--line) !important;
        border-radius: 14px !important;
        box-shadow: none !important;
    }
    /* 卡片小标题：跟 mockup 一样蓝色大写小字 */
    .er-head {
        color: var(--acc2) !important;
        font-size: 13.5px !important;
        font-weight: 700;
        letter-spacing: .6px;
        text-transform: uppercase;
    }
    /* 页头：logo + 字标 + 版本，学 ORBIT 那种排法 */
    .er-brand { display: flex; align-items: center; gap: 13px; }
    /* 图标自带深底 + 发光箭头，容器只负责尺寸与投影 */
    .er-logo {
        width: 46px; height: 46px; border-radius: 13px; flex: 0 0 auto;
        display: grid; place-items: center; overflow: hidden;
        box-shadow: 0 8px 22px #ffc23c26, 0 0 0 1px #ffffff14;
    }
    .er-wordmark {
        font-size: 23px; font-weight: 800; letter-spacing: .16em;
        color: var(--txt); line-height: 1.1; text-transform: uppercase;
    }
    .er-ver {
        font-size: 11.5px; padding: 2px 9px; border-radius: 999px;
        border: 1px solid var(--acc); color: var(--acc);
        font-variant-numeric: tabular-nums; letter-spacing: .3px;
    }
    .er-sub { color: var(--dim); font-size: 12.5px; margin-top: 3px; }
    /* 顶部状态胶囊 */
    .er-chip {
        display: inline-flex; align-items: center; gap: 7px;
        background: var(--panel); border: 1px solid var(--line); border-radius: 999px;
        padding: 6px 13px; font-size: 12.5px; color: var(--dim);
        font-variant-numeric: tabular-nums;
    }
    .er-chip .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--acc2); }
    .er-chip .dot.warn { background: var(--acc); }
    /* 活动行 */
    .er-row { border-bottom: 1px solid rgba(32, 48, 76, .7); }
    .er-row:hover { background: rgba(87, 182, 255, .04); }
    .er-id { color: var(--dim); opacity: .7; font-size: .72rem; }
    .er-meta {
        border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px;
        font-size: 11.5px; color: var(--dim); font-variant-numeric: tabular-nums;
    }
    .er-desc { color: var(--dim); font-size: 12.5px; line-height: 1.55; }
    /* 侧栏 */
    .mud-nav-link { border-radius: 9px; }
    .mud-nav-link.active, .mud-nav-link.mud-nav-link-active { background: rgba(87, 182, 255, .10) !important; }
    .mud-button-root { text-transform: none !important; }
</style>

<div class="pa-6" style="max-width:1180px;margin:0 auto">
    @Body
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#ffc23c",
            Secondary = "#57b6ff",
            Background = "#0a1020",
            Surface = "#111a2e",
            AppbarBackground = "#0a1020",
            TextPrimary = "#e8eefb",
            TextSecondary = "#93a6c4",
            DrawerBackground = "#0d1526",
            Divider = "#20304c",
        },
    };
}
