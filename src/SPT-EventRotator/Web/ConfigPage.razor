    private IEnumerable<IGrouping<string, ConfigWebService.EventRow>> _groups =>
        _events.GroupBy(e => string.IsNullOrEmpty(e.Category) ? "other" : e.Category)
               .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<ConfigWebService.EventRow> ShownEvents
    {
        get
        {
            var q = _search?.Trim() ?? "";
            IEnumerable<ConfigWebService.EventRow> rows = _events;
            if (q.Length > 0)
            {
                // ★ 第 16 项：搜索范围扩到「描述文字」（中文 Desc / 英文 DescEn），其余匹配保持原样
                rows = rows.Where(e => (e.Id ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                                    || (e.Label ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                                    || (e.En ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                                    || (e.Desc ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                                    || (e.DescEn ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                rows = rows.Where(e => string.Equals(string.IsNullOrEmpty(e.Category) ? "other" : e.Category, _activeCat, StringComparison.OrdinalIgnoreCase));
            }
            // ★ 第 16 项：地图 / 标签 / 只看已排除 —— 与上面的分类/搜索**同一套过滤**，纯前端，不写盘
            if (!string.Equals(_mapFilter, "all", StringComparison.Ordinal)) rows = rows.Where(e => TouchesMap(e.Touches, _mapFilter));
            if (!string.Equals(_tagFilter, "all", StringComparison.Ordinal)) rows = rows.Where(e => string.Equals(NormTag(e.UiTag), _tagFilter, StringComparison.OrdinalIgnoreCase));
            if (_onlyExcluded) rows = rows.Where(e => _excluded.Contains(e.Id));
            return rows;
        }
    }

    /// <summary>过滤后的条数（顶部「显示 X / N 个」用；与 <see cref="ShownEvents"/> 同一套谓词，没有第二套过滤逻辑）。</summary>
    private int ShownCount => ShownEvents.Count();

    /// <summary>标签归一化：ready / simulated / experimental；未知值按 simulated（与徽章 TagColor/TagLabel 同口径）。</summary>
    private static string NormTag(string tag) => (tag ?? "").Trim().ToLowerInvariant() switch
    {
        "ready" => "ready",
        "experimental" => "experimental",
        _ => "simulated",
    };

    /// <summary>
    /// 地图筛选：<c>EventRow.Touches</c> 里是否有「<c>维度:地图id</c>」且地图命中的 token（如 <c>bosses:laboratory</c>）。
    /// <para>契约 v2 的 token 只有一个冒号；不带冒号的全局 token 不算命中 ⇒ 纯全局活动只在「全部地图」下显示。</para>
    /// </summary>
    private static bool TouchesMap(string touches, string map)
    {
        if (string.IsNullOrEmpty(touches) || string.IsNullOrEmpty(map)) return false;
        foreach (var raw in touches.Split(','))
        {
            var tok = raw.Trim();
            int idx = tok.IndexOf(':');
            if (idx <= 0 || idx + 1 >= tok.Length) continue;
            if (string.Equals(tok.Substring(idx + 1).Trim(), map, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

