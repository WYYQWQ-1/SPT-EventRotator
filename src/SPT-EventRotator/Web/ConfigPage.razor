    /// <summary>点一下就加入/移出强制列表（force.txt 支持逗号分隔多个活动）。</summary>
    private void ToggleForce(string id)
    {
        var ids = new List<string>(_forceIds);
        if (ids.Contains(id, StringComparer.OrdinalIgnoreCase))
            ids.RemoveAll(x => string.Equals(x, id, StringComparison.OrdinalIgnoreCase));
        else
            ids.Add(id);

        var (ok, msg) = CfgSvc.SetForce(ids);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        RefreshForceState();
        if (_previewOpen) BuildPreviewForMap();   // ★ 契约 v3：强制集合也是预览输入 ⇒ 面板开着就同步重建（不改任何写盘逻辑）
        _chips = BuildChips(CfgSvc.StatusText);
        StateHasChanged();
    }

