@page "/eventrotator"
@layout EventRotator.Web.Shared.MainLayout
@inject ConfigWebService CfgSvc
@inject ISnackbar Snackbar

<div class="er-brand mb-3">
    <div class="er-logo">
        <img src="@_logoSrc" width="46" height="46" style="border-radius:13px;display:block" alt="EventRotator" />
    </div>
    <div>
        <div class="d-flex align-center gap-2">
            <span class="er-wordmark">EventRotator</span>
            <span class="er-ver">v@_version</span>
        </div>
        <div class="er-sub">@L("活动轮换配置 · 保存即热生效，标 ⟳ 的项需重启", "Event rotation config · saved changes hot-apply; items marked ⟳ need a restart")</div>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Translate" OnClick="ToggleLang">
        @(_zh ? "EN" : "中文")
    </MudButton>
</div>

<div class="d-flex flex-wrap gap-2 align-center mb-3">
    @foreach (var (kind, value, warn) in _chips)
    {
        <span class="er-chip">
            <span class="dot @(warn ? "warn" : "")"></span>
            <span>@ChipLabel(kind)</span>
            <b style="color:#57b6ff">@value</b>
        </span>
    }
    <MudSpacer />
    @if (ChangedCount > 0)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
            @L($"未保存改动 {ChangedCount}", $"{ChangedCount} unsaved")
        </MudChip>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ResetAll">@L("撤销改动", "Reset")</MudButton>
    }
</div>

@if (_cfg == null)
{
    <MudAlert Severity="Severity.Error">@L("读不到 config.json（服务端可能还没加载完，或文件已损坏）", "Could not read config.json")</MudAlert>
}
else
{
    <div class="d-flex align-start gap-4">
        <MudPaper Elevation="1" Style="width:240px;flex:0 0 240px;position:sticky;top:8px">
            <MudNavMenu Class="py-2">
                <MudText Typo="Typo.overline" Class="px-4 mb-1" Style="opacity:.45">@L("配置", "CONFIG")</MudText>
                @foreach (var t in _tabs)
                {
                    <MudNavLink Icon="@t.icon" OnClick="@(() => _active = t.id)"
                                Style="@(_active == t.id ? "font-weight:600;color:#ffc23c" : "")">
                        @L(t.zh, t.en)
                    </MudNavLink>
                }
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.overline" Class="px-4 mb-1" Style="opacity:.45">@L("活动分类", "EVENT GROUPS")</MudText>
                @foreach (var g in _groups)
                {
                    <MudNavLink OnClick="@(() => { _active = "events"; _activeCat = g.Key; })"
                                Style="@(_active == "events" && _activeCat == g.Key ? "font-weight:600;color:#57b6ff" : "")">
                        @CatName(g.Key) · @g.Count()
                    </MudNavLink>
                }
            </MudNavMenu>
        </MudPaper>

        <div style="flex:1;min-width:0">
            @if (_active == "basics")
            {
                @* ★★★ v2.7.0【硬开关 · 不启用任何活动】放在「基础」页最顶部：这是"一键回到裸 SPT"的总闸。 *@
                <MudPaper Class="pa-4 mb-4" Elevation="1" Style="border-left:4px solid #ff5252">
                    <div class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="_disableAllEvents" Color="Color.Error"
                                   Label="@L("不启用任何活动（硬开关）", "Disable all events (hard switch)")" />
                        @Info("disableAllEvents")
                    </div>
                    <div class="er-desc" style="margin:2px 0 0">
                        @L("开启后无论如何都不套用任何活动：force.txt 手动强制、主轮换、季节阶段自动接管、日期窗、奖励轮换全部忽略；"
                            + "服务端会先执行一次完整还原（首领/敌对性、战利品 transformer、天气、地点感染、外部联动 Blackout…），"
                            + "然后停在裸 SPT 状态。下次启动仍是裸 SPT；关掉开关即恢复正常轮换（保存后立刻热生效）。",
                            "When on, no event is ever applied: force.txt, the main rotation, seasonal-phase takeover, date windows and "
                            + "reward rotation are all ignored, and every change made by a previously applied event is restored once "
                            + "(bosses/hostility, loot transformers, weather, map infection, Blackout bridge...), leaving a vanilla SPT "
                            + "server. It stays that way after a restart; turning it off restores normal rotation immediately on save.")
                    </div>
                </MudPaper>

                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <MudText Class="er-head mb-3">@L("日志与兜底", "Logging & fallbacks")</MudText>
                    <MudSelect T="string" @bind-Value="_logLevel" Label="@L("日志等级", "Log level")" Style="max-width:320px" Class="mb-1">
                        <MudSelectItem T="string" Value="@("off")">@L("关闭", "off")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("basic")">@L("基础", "basic")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("verbose")">@L("详细（逐条明细）", "verbose")</MudSelectItem>
                    </MudSelect>
                    @Hint("logLevel")

                    <div class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="_weaponFallback" Color="Color.Warning" Label="@L("武器兜底：主武器模板缺失时换原版", "Weapon fallback: swap to vanilla when the tpl is missing")" />
                        @Info("weaponFallback")
                    </div>

                    <div class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="_sainPresetInject" Color="Color.Warning" Label="@L("SAIN 预设注入", "Inject SAIN presets")" />
                        @Info("sainPresetInject")
                        <MudTooltip Text="@(L("这项只在启动时执行一次，改完必须重启服务端。", "Runs once at startup; a server restart is required."))" Placement="Placement.Top" Arrow="true">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Style="margin-left:8px">⟳ @L("需重启", "restart")</MudChip>
                        </MudTooltip>
                    </div>

                    @* ★ 2026-10-31【灾厄小队 · 帧数警告】这条开关在**客户端 F12**里，不在服务端配置里，
                       但玩家最常在这一页翻设置 ⇒ 放这里提醒：开了会明显掉帧（每个灾厄单位每帧多 6 层判定）。 *@
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        <b>@L("灾厄小队：开启「套黑狐层」会大幅掉帧", "Scourge squad: enabling \"SAIN / BlackDiv layers\" causes a large FPS drop")</b><br />
                        @L("客户端 F12 →「★灾厄小队套黑狐层」默认是**关**：随从只吃本 mod 的 3 层 AI，帧数优先。",
                           "The client-side switch (F12 -> \"use SAIN/BlackDiv layers\") defaults to OFF: followers use only this mod's 3 AI layers, for better FPS.")<br />
                        @L("一旦打开：每个灾厄单位每帧要多跑 6 层判定（一队 5 个 ≈ 每帧多 30 次）⇒ 行为更像黑狐小队，但**帧数会明显下降**。只在真的需要那种行为时才开。",
                           "Turned ON: each Scourge unit runs 6 extra layer checks per frame (5 units ≈ 30 extra checks/frame) -> behaviour closer to the Black Division squad, but a noticeable FPS drop. Enable only if you really want that behaviour.")
                    </MudAlert>
                </MudPaper>
            }
            else if (_active == "rotation")
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <div class="d-flex align-center mb-3">
                        <MudSwitch T="bool" @bind-Value="_rotEnabled" Color="Color.Warning" Label="@L("启用轮换", "Enable rotation")" />
                        @Info("rotationEnabled")
                    </div>
                    <MudSelect T="string" @bind-Value="_rotMode" Label="@L("模式", "Mode")" Style="max-width:320px" Class="mb-1">
                        <MudSelectItem T="string" Value="@("random")">@L("随机（每档打乱）", "random (shuffled)")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("sequential")">@L("顺序（依次推进）", "sequential")</MudSelectItem>
                    </MudSelect>
                    @Hint("mode")
                    <div class="d-flex flex-wrap gap-4 mb-4">
                        <MudNumericField T="int" @bind-Value="_rotDays" Label="@L("间隔天数", "Interval (days)")" Min="1" Max="365" Style="max-width:180px" />
                        <MudNumericField T="int" @bind-Value="_rotCount" Label="@L("每档活动数", "Events per slot")" Min="1" Max="10" Style="max-width:180px" />
                        <MudNumericField T="int" @bind-Value="_rebaseHour" Label="@L("换档基准小时", "Rebase hour")" Min="0" Max="23" Style="max-width:180px" />
                    </div>
                    <MudNumericField T="int" @bind-Value="_seed" Label="@L("种子", "Seed")" Style="max-width:280px" Class="mb-1" />
                    @Hint("seed")
                    <div class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="_onlyGap" Color="Color.Warning" Label="@L("只在季节间隙轮换", "Only rotate between seasons")" />
                        @Info("onlyGap")
                    </div>

                    <MudDivider Class="my-4" />
                    <MudText Class="er-head mb-2">@L("奖励活动", "Reward events")</MudText>
                    <div class="d-flex align-center mb-3">
                        <MudSwitch T="bool" @bind-Value="_rewardEnabled" Color="Color.Warning" Label="@L("启用奖励轮换", "Enable reward rotation")" />
                        @Info("rewardEnabled")
                    </div>
                    <div class="d-flex flex-wrap gap-4 mb-3">
                        <MudNumericField T="int" @bind-Value="_rewardMin" Label="@L("最少", "Min")" Min="0" Max="10" Style="max-width:150px" />
                        <MudNumericField T="int" @bind-Value="_rewardMax" Label="@L("最多", "Max")" Min="0" Max="10" Style="max-width:150px" />
                    </div>
                    <div class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="_rewardAvoid" Color="Color.Warning" Label="@L("奖励活动也避冲突", "Reward events respect conflicts")" />
                        @Info("rewardAvoid")
                    </div>
                </MudPaper>
            }
            else if (_active == "seasons")
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <MudSelect T="string" @bind-Value="_seasonMode" Label="@L("模式", "Mode")" Style="max-width:320px" Class="mb-1">
                        <MudSelectItem T="string" Value="@("rotate")">@L("依次轮换", "rotate")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("followEvent")">@L("跟随活动季节", "followEvent")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("fixed")">@L("固定季节", "fixed")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("off")">@L("跟随现实日期", "off")</MudSelectItem>
                    </MudSelect>
                    @Hint("seasonMode")
                    <div class="d-flex flex-wrap gap-4 mb-4">
                        <MudNumericField T="int" @bind-Value="_seasonDays" Label="@L("每季天数", "Days per season")" Min="1" Max="365" Style="max-width:180px" />
                        <MudNumericField T="int" @bind-Value="_seasonOffset" Label="@L("偏移档", "Offset slots")" Min="-48" Max="48" Style="max-width:180px" />
                    </div>
                    @Hint("seasonDays")
                    <div class="d-flex flex-wrap gap-4">
                        <MudSelect T="string" @bind-Value="_season" Label="@L("固定季节", "Fixed season")" Style="max-width:200px">
                            <MudSelectItem T="string" Value="@("SPRING")">@L("春 SPRING", "SPRING")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("SUMMER")">@L("夏 SUMMER", "SUMMER")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("AUTUMN")">@L("秋 AUTUMN", "AUTUMN")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("WINTER")">@L("冬 WINTER", "WINTER")</MudSelectItem>
                        </MudSelect>
                        @Info("fixedSeason")
                        <MudSelect T="string" @bind-Value="_phase" Label="@L("季节活动阶段", "Seasonal event phase")" Style="max-width:220px">
                            <MudSelectItem T="string" Value="@("off")">@L("不开启", "off")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("start")">@L("季初", "start")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("middle")">@L("季中", "middle")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("end")">@L("季末", "end")</MudSelectItem>
                        </MudSelect>
                    </div>
                    @Hint("phase")

                    <MudDivider Class="my-4" />
                    <div class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="_takeoverVanilla" Color="Color.Warning"
                                   Label="@L("接管原版季节窗（关掉官方按日期自动开节日）", "Take over vanilla seasonal windows")" />
                    </div>
                    <div class="er-desc" style="margin:2px 0 10px">
                        @L("开（默认）= 关闭 SPT 的「按现实日期自动开官方活动」，全部官方季节窗都交给我们调度：万圣节 10/28–11/9、圣诞 12/13–12/31、圣诞 1 月档 1/2–1/14、新年 1/1、愚人节 4/1。",
                            "On (default) = disable SPT's date-based auto seasonal events; this mod owns all of them: Halloween Oct 28-Nov 9, Christmas Dec 13-31, Christmas Jan Jan 2-14, New Year Jan 1, April Fools Apr 1.")
                        <br />
                        @L("落点：SPT_Data\\configs\\seasonalevents.json → enableSeasonalEventDetection（改前自动留 .bak-eventrotator 备份，可回退）。改完需重启服务端。",
                            "Where: SPT_Data\\configs\\seasonalevents.json -> enableSeasonalEventDetection (auto-backed up as .bak-eventrotator). Restart the server after changing.")
                    </div>

                    <MudDivider Class="my-4" />
                    @* ★ 第 26 项：独立天气开关（config.json → weather.suppressRainSnow / weather.suppressFog）
                       两项互相独立；都不开 = 天气完全不干预（与没装本补丁逐字节一致）。
                       落点：服务端 WeatherSuppressPatch（WeatherController.Generate / GenerateLocal /
                       RaidWeatherService.GetCurrentWeather / GetUpcomingWeather 的 postfix）。 *@
                    <div class="d-flex align-center flex-wrap gap-4">
                        <MudSwitch T="bool" @bind-Value="_suppressRainSnow" Color="Color.Info"
                                   Label="@L("压制 雨/雪", "Suppress rain / snow")" />
                        <MudSwitch T="bool" @bind-Value="_suppressFog" Color="Color.Info"
                                   Label="@L("压制 浓雾", "Suppress heavy fog")" />
                    </div>
                    <div class="er-desc" style="margin:2px 0 10px">
                        @L("两个开关互相独立：只压雨雪、只压雾、两个都压都可以；两个都不开（默认）= 天气一个字段都不改，等于没装这个补丁。",
                            "The two switches are independent (rain/snow only, fog only, or both). Both off (default) = no weather field is touched at all.")
                        <br />
                        @L("雨/雪：Rain=1、RainIntensity=0（与 SPT 晴天预设取值一致；雪在寒冷季共用这条 Rain 通道，所以一并压掉）。浓雾：Fog=0.0001（比 SPT 雾值表里最小的 0.0013 还低约 13 倍，实测等价于无雾）。",
                            "Rain/snow: Rain=1, RainIntensity=0 (same values as SPT's sunny preset; snow uses the same Rain channel). Fog: Fog=0.0001 (~13x below SPT's lowest preset fog value 0.0013).")
                        <br />
                        @L("两者都**不影响**活动轮换、季节判定，也不动云量 / 风 / 风向 / 阵风 / 气压 / 温度（这些字段一个字都不改）。进下一局自动生效，不需要重启服务端。",
                            "Neither switch affects event rotation, season logic, cloud, wind, gustiness, pressure or temperature - those are never touched. Applies from the next raid, no server restart needed.")
                    </div>

                    <MudDivider Class="my-4" />
                    @* ★ 第 23 项：日期窗规则（config.json 顶层键 dateWindowRule，枚举白名单 seasonOffOnly | always） *@
                    <MudSelect T="string" @bind-Value="_dateWindowRule" Label="@L("日期窗规则", "Date-window rule")" Style="max-width:380px" Class="mb-1">
                        <MudSelectItem T="string" Value="@("seasonOffOnly")">@L("跟随季节轮换（默认）", "Follow season rotation (default)")</MudSelectItem>
                        <MudSelectItem T="string" Value="@("always")">@L("始终生效（旧行为）", "Always active (legacy)")</MudSelectItem>
                    </MudSelect>
                    <div class="er-desc" style="margin:2px 0 10px">
                        @L("跟随季节轮换（seasonOffOnly，默认）= 日期窗只在「季节模式 = 跟随现实日期」时生效；其它季节模式（依次轮换 / 跟随活动季节 / 固定季节）遵循轮换规则，不看日期窗。",
                            "Follow season rotation (seasonOffOnly, default) = date windows only apply while season mode = real calendar; other modes (rotate / followEvent / fixed) follow the rotation rules and ignore date windows.")
                        <br />
                        @L("始终生效（always）= 日期窗永远参与，不管季节模式是什么（这是本选项出现之前的旧行为）。",
                            "Always active (always) = date windows always take part regardless of season mode (the legacy behavior before this option existed).")
                    </div>
                    @Hint("dateWindowRule")
                </MudPaper>
            }
            else if (_active == "events")
            {
                @* ★ B 线（契约 v3）：进图预览 —— 可折叠、默认收起、**纯只读**。
                   只在「展开 / 换图 / 点强制」时调 CfgSvc.BuildPreview()，不写配置、不碰 force.txt、不触发保存。 *@
                <MudPaper Class="pa-3 mb-4" Elevation="1">
                    <div class="d-flex flex-wrap align-center" style="cursor:pointer;gap:8px" @onclick="TogglePreview">
                        <MudIcon Icon="@(_previewOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Style="opacity:.7" />
                        <MudText Class="er-head">@L("进图预览", "Raid preview")</MudText>
                        <span class="er-meta">@L("选地图看下次进图会变什么", "pick a map to see what changes next raid")</span>
                    </div>
                    @if (_previewOpen)
                    {
                        <div class="d-flex flex-wrap align-center" style="gap:12px;margin:10px 0 4px">
                            <MudSelect T="string" @bind-Value="PreviewMap" Label="@L("地图", "Map")" Style="max-width:360px">
                                @foreach (var m in _previewMaps)
                                {
                                    <MudSelectItem T="string" Value="@m.Id">@L(m.Zh, m.En) · @m.Id</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        @if (!string.IsNullOrEmpty(_previewError))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-2" Dense="true">@L("预览生成失败：", "Preview failed: ")@_previewError</MudAlert>
                        }
                        var groups = OrderedPreviewGroups();
                        @if (groups.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Style="opacity:.6">@L("这张图当前没有任何改动（按「已生效 + 已强制」推导）。", "Nothing affects this map right now (based on applied + forced events).")</MudText>
                        }
                        else
                        {
                            @foreach (var g in groups)
                            {
                                <div class="er-head" style="margin:12px 0 2px">@PreviewTitle(g.Key, g.Title)</div>
                                @foreach (var it in g.Items)
                                {
                                    var fromText = FromLabel(it.From, it.FromName);
                                    <div class="d-flex flex-wrap align-center py-1" style="gap:8px;border-bottom:1px solid rgba(255,255,255,.06)">
                                        <span style="flex:1 1 320px;min-width:240px">@it.Text</span>
                                        @if (!string.IsNullOrEmpty(fromText))
                                        {
                                            <span class="er-meta" style="flex:0 0 auto;opacity:.6">@fromText</span>
                                        }
                                    </div>
                                }
                            }
                        }
                        @if (_preview?.Warnings != null && _preview.Warnings.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                                @foreach (var w in _preview.Warnings)
                                {
                                    <div>· @w</div>
                                }
                            </MudAlert>
                        }
                        <MudText Typo="Typo.caption" Style="opacity:.55;margin-top:10px;display:block">@L("预览为近似推导，实际以游戏内为准", "Approximation only - the in-game result is authoritative")</MudText>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <div class="d-flex flex-wrap gap-3 align-center mb-3">
                        <MudText Class="er-head">@CatName(_activeCat)</MudText>
                        <MudTextField T="string" @bind-Value="_search" Immediate="true" DebounceInterval="200" Placeholder="@L("搜活动名 / id / 描述", "Search name / id / description")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:300px" />
                        @Info("search")
                        @* ★ 第 16 项：地图 / 标签 两个筛选（纯前端；数据来自 EventRow.Touches 的「维度:地图id」与 UiTag） *@
                        <MudSelect T="string" @bind-Value="_mapFilter" Label="@L("地图", "Map")" Style="max-width:190px">
                            <MudSelectItem T="string" Value="@("all")">@L("全部地图", "All maps")</MudSelectItem>
                            @foreach (var m in _previewMaps)
                            {
                                <MudSelectItem T="string" Value="@m.Id">@L(m.Zh, m.En)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_tagFilter" Label="@L("标签", "Tag")" Style="max-width:170px">
                            <MudSelectItem T="string" Value="@("all")">@L("全部标签", "All tags")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("ready")">@L("原生", "Ready")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("simulated")">@L("模拟", "Simulated")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("experimental")">@L("实验", "Experimental")</MudSelectItem>
                        </MudSelect>
                        <MudCheckBox T="bool" @bind-Value="_onlyExcluded" Color="Color.Warning" Label="@L("只看已排除", "Only excluded")" />
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Style="opacity:.75">@L($"显示 {ShownCount} / {_events.Count} 个", $"showing {ShownCount} / {_events.Count}")</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L("已排除", "Excluded") @_excluded.Count</MudChip>
                    </div>
                    @if (!string.Equals(_mapFilter, "all", StringComparison.Ordinal) || !string.Equals(_tagFilter, "all", StringComparison.Ordinal))
                    {
                        <div class="er-desc" style="margin:-6px 0 8px">
                            @L("筛选说明：地图筛只看「明确作用到这张图」的活动（EventRow.Touches 里带 维度:地图 的标记，如 bosses:laboratory）；纯全局活动（商人 / 跳蚤 / 藏身处这类没有地图标记的）只在选「全部地图」时出现。",
                                "Filter note: the map filter keeps only events with a map-specific touch (tokens like bosses:laboratory in EventRow.Touches). Purely global events (traders / flea / hideout ... with no map token) only show under All maps.")
                        </div>
                    }

                    @Hint("exclude")

                    @if (_forceIds.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                            @L("当前强制开启（可多个）：", "Forced (multiple allowed): ") @string.Join(", ", _forceIds)
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning" OnClick="ClearForce" Class="ml-3">@L("清空", "Clear")</MudButton>
                        </MudAlert>
                    }

                    @if (_forceIds.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mb-2" Style="opacity:.75">
                            @L("⚠ 强制只改变「该开哪些活动」；实际战场效果（bot / 掉落 / 天气）要等下一场战局才生效。",
                               "⚠ Force only changes which events are active; actual in-raid effects apply on your NEXT raid.")
                        </MudText>
                        @if (_forceNotApplied || _forceUnknown.Count > 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-2" Dense="true">
                                @if (_forceNotApplied)
                                {
                                    <div>@L("服务端没有识别到强制（当前状态仍是「自动」）。可能是 force.txt 里的 id 写错，或格式不对。", "The server did not pick up the force (status still says automatic). Check the ids in force.txt.")</div>
                                }
                                @if (_forceUnknown.Count > 0)
                                {
                                    <div>@L("force.txt 里有活动表里不存在的 id：", "Unknown ids in force.txt: ")@string.Join(", ", _forceUnknown)</div>
                                }
                            </MudAlert>
                        }
                        @if (_forceConflicts.Count > 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-2" Dense="true">
                                <div style="font-weight:600">@L("检测到强制活动互相冲突（后写的会覆盖前一个）：", "Forced events conflict (the later one overwrites the earlier):")</div>
                                @foreach (var c in _forceConflicts)
                                {
                                    <div>· @c</div>
                                }
                            </MudAlert>
                        }
                    }

                    @if (ShownCount == 0)
                    {
                        <MudText Typo="Typo.body2" Style="opacity:.6">@L("没有符合当前筛选条件的活动（换个搜索词，或把「地图 / 标签」改回全部）。", "No events match the current filters (try another search term, or set Map / Tag back to All).")</MudText>
                    }
                    @foreach (var e in ShownEvents)
                    {
                        <div class="er-row d-flex align-start py-2">
                            <MudCheckBox T="bool" Value="@_excluded.Contains(e.Id)" ValueChanged="@((bool v) => ToggleExclude(e.Id, v))" Color="Color.Warning" Dense="true" />
                            <div style="flex:1 1 480px;min-width:280px">
                                <div class="d-flex flex-wrap gap-2 align-center">
                                    <MudText Typo="Typo.body2" Style="font-weight:600">@(_zh ? e.Label : (string.IsNullOrEmpty(e.En) ? e.Label : e.En))</MudText>
                                    @* ★ B 线：实现程度徽章（Ready 绿 / Simulated 蓝 / Experimental 橙，未知值按 simulated） *@
                                    <MudTooltip Text="@TagHint(e.UiTag)" Placement="Placement.Top" Arrow="true">
                                        <MudChip T="string" Size="Size.Small" Color="@TagColor(e.UiTag)" Variant="Variant.Text" Style="font-size:11px;white-space:nowrap;flex:0 0 auto">@TagLabel(e.UiTag)</MudChip>
                                    </MudTooltip>
                                    <code class="er-id" style="flex:0 0 auto">@e.Id</code>
                                    @if (!string.Equals(e.Window, "-"))
                                    {
                                        <span class="er-meta" style="flex:0 0 auto;white-space:nowrap">@e.Window</span>
                                    }
                                    @* ★ B 线：日期窗倒计时（StartDay > 0 才算；纯前端按本地今天算） *@
                                    @{ var countdown = e.StartDay > 0 ? CountdownText(e) : ""; }
                                    @if (!string.IsNullOrEmpty(countdown))
                                    {
                                        <span class="er-meta" style="opacity:.8;flex:0 0 auto;white-space:nowrap">@countdown</span>
                                    }
                                    @if (e.Always)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">always</MudChip>
                                    }
                                </div>
                                @{ var d = _zh ? e.Desc : (string.IsNullOrEmpty(e.DescEn) ? e.Desc : e.DescEn); }
                                @if (!string.IsNullOrEmpty(d))
                                {
                                    <div class="er-desc">@d</div>
                                }
                                @* ★ 冲突提示（2026-10-29 改版）：不再一行挂 N 个长 chip —— 那会把标题列挤成 100px。
                                   改成「一枚摘要 chip + 悬浮看完整名单」，永远只占一行的宽度。 *@
                                @{ var conflicts = ConflictsOf(e); }
                                @* ★ 契约 v2【双向才警告】：本行自己也在「开启 / 强制」状态才提示（判据 = IsCheckedOrActive(e.Id)：_forceIds ∪ StatusText 生效列表）；
                                   否则整枚 chip 不渲染 —— 门禁放在 @if 上，所以外层那个 div 也不会产生。 *@
                                @if (conflicts.Count > 0 && IsCheckedOrActive(e.Id))
                                {
                                    <div class="d-flex flex-wrap gap-2 align-center" style="margin-top:4px">
                                        <MudTooltip Placement="Placement.Bottom" Arrow="true">
                                            <ChildContent>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                                         Style="font-size:11px;white-space:nowrap">
                                                    @L($"⚠ 与 {conflicts.Count} 个已开启活动冲突", $"⚠ conflicts with {conflicts.Count} enabled event(s)")
                                                </MudChip>
                                            </ChildContent>
                                            <TooltipContent>
                                                <div style="max-width:420px;line-height:1.6">
                                                    @foreach (var c in conflicts)
                                                    {
                                                        <div>· @c.Name @(string.IsNullOrEmpty(c.Tip) ? "" : "— " + c.Tip)</div>
                                                    }
                                                </div>
                                            </TooltipContent>
                                        </MudTooltip>
                                    </div>
                                }

                                @* ★ 第 17 + 20 项：任务链展开 + 其它 mod 兼容提示（每行独立、默认收起、展开才渲染内容） *@
                                @{
                                    var quests = e.Quests;
                                    var chainTotal = quests?.Count ?? 0;
                                    var chainMissing = 0;
                                    if (quests != null)
                                    {
                                        foreach (var q in quests) { if (q != null && !q.Present) chainMissing++; }
                                    }
                                    var compat = CompatForMap(e);
                                    var rowOpen = _expandedRows.Contains(e.Id ?? "");
                                }
                                @if (chainTotal > 0 || compat.Count > 0)
                                {
                                    <div style="margin-top:4px">
                                        <div class="d-flex flex-wrap align-center" style="cursor:pointer;gap:6px" @onclick="@(() => ToggleRow(e.Id))">
                                            <MudIcon Icon="@(rowOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Style="opacity:.7" />
                                            <MudText Typo="Typo.caption" Style="opacity:.85">@RowToggleTitle(e, chainTotal, chainMissing, compat.Count)</MudText>
                                            @if (compat.Count > 0 && chainTotal > 0)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Style="font-size:11px">
                                                    @L($"其它 mod · {compat.Count} 条", $"other mods · {compat.Count}")
                                                </MudChip>
                                            }
                                        </div>
                                        @if (rowOpen)
                                        {
                                            <div style="margin:4px 0 2px 24px">
                                                @if (chainTotal > 0)
                                                {
                                                    var chain = QuestChainOf(e);
                                                    @foreach (var q in chain)
                                                    {
                                                        var missing = q != null && !q.Present;
                                                        <div class="d-flex flex-wrap align-center" style="gap:6px;padding:1px 0;@(missing ? "opacity:.5" : "")"
                                                             title="@(string.IsNullOrEmpty(q?.Source) ? "" : q.Source)">
                                                            <span style="min-width:20px;opacity:.6">@(chain.IndexOf(q) + 1).</span>
                                                            <span style="flex:1 1 300px;min-width:200px">@QuestDisplayName(q)</span>
                                                            @if (!string.IsNullOrEmpty(q?.Trader))
                                                            {
                                                                <span class="er-meta">@q.Trader</span>
                                                            }
                                                            @if (q != null && q.Level > 0)
                                                            {
                                                                <span class="er-meta">Lv@(q.Level)</span>
                                                            }
                                                            @if (q != null && q.FromOurQuestline)
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Style="font-size:10px">@L("我们", "ours")</MudChip>
                                                            }
                                                            else if (!missing)
                                                            {
                                                                <span class="er-meta">@L("原版已有", "vanilla")</span>
                                                            }
                                                            @if (missing)
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Style="font-size:10px">@L("本机没有", "missing locally")</MudChip>
                                                            }
                                                        </div>
                                                    }
                                                }
                                                @if (compat.Count > 0)
                                                {
                                                    <div class="er-head" style="margin:8px 0 2px;font-size:12px">@L($"其它 mod 在这张图上的动静（{compat.Count} 条）", $"Other mods on this map ({compat.Count})")</div>
                                                    @foreach (var n in compat)
                                                    {
                                                        <div class="d-flex flex-wrap align-center" style="gap:6px;padding:1px 0">
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Style="font-size:10px;white-space:nowrap">@n.Source</MudChip>
                                                            <span style="flex:1 1 300px;min-width:200px">@(_zh ? n.Text : (string.IsNullOrEmpty(n.TextEn) ? n.Text : n.TextEn))</span>
                                                            @if (!string.IsNullOrEmpty(n.Map) && n.Map != "*")
                                                            {
                                                                <span class="er-meta">@n.Map</span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <span style="flex:0 0 auto">
                                @if (_forceIds.Contains(e.Id))
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => ToggleForce(e.Id))" Style="white-space:nowrap">@L("取消强制", "Unforce")</MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning" OnClick="@(() => ToggleForce(e.Id))" Style="white-space:nowrap">@L("手动开启", "Force")</MudButton>
                                }
                            </span>
                            @* ★ B 线：有 Wiki 才显示外链小图标（新窗口打开；不引新依赖，用现有 Icons.Material.Filled） *@
                            @if (!string.IsNullOrEmpty(e.Wiki))
                            {
                                <MudTooltip Text="@L("在浏览器打开该活动的 Wiki（新窗口）", "Open this event's wiki in a new tab")" Placement="Placement.Top" Arrow="true">
                                    <a href="@e.Wiki" target="_blank" rel="noopener" style="flex:0 0 auto;align-self:center;display:inline-flex;opacity:.65;margin-left:4px">
                                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                    </a>
                                </MudTooltip>
                            }
                        </div>
                    }
                </MudPaper>
            }
            else if (_active == "backups")
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    @if (_backups.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="opacity:.6">@L("还没有网页保存记录", "No web saves yet")</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" @bind-Value="_selectedBackup" Label="@L("选一份回滚", "Pick a backup")" Style="max-width:520px" Class="mb-3">
                            @foreach (var b in _backups)
                            {
                                <MudSelectItem T="string" Value="@b">@b</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="RestoreSelected" Disabled="@(string.IsNullOrEmpty(_selectedBackup))">@L("回滚到这份", "Restore this one")</MudButton>
                    }
                </MudPaper>
            }
        </div>
    </div>

    <MudPaper Class="pa-3 d-flex align-center mt-4" Elevation="4" Style="position:sticky;bottom:12px">
        <MudText Typo="Typo.caption" Style="opacity:.7">
            @L("保存 → 写备份 → 热生效｜标 ⟳ 的项（SAIN 预设注入、枚举预补丁）保存后仍需重启",
               "Save → back up → hot-apply｜items marked ⟳ still need a restart")
        </MudText>
        <MudSpacer />
        <MudTooltip Text="@(L("写文件 + 备份 + 重读配置 + 重算活动；没有改动时等于重新应用一遍", "Writes file, backs up, re-reads config, recomputes; with no pending changes it just re-applies"))" Placement="Placement.Top" Arrow="true">
            <span>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="SaveAsync">
                    @(ChangedCount > 0 ? L($"保存并应用（{ChangedCount} 项）", $"Save & apply ({ChangedCount})") : L("重新应用", "Re-apply"))
                </MudButton>
            </span>
        </MudTooltip>
    </MudPaper>
}

