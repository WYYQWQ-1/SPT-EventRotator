    private void Reload()
    {
        _version = CfgSvc.Version;
        _cfg = CfgSvc.Load();
        _backups = CfgSvc.ListBackups();
        _chips = BuildChips(CfgSvc.StatusText);
        _events = CfgSvc.ListEvents();
        RefreshForceState();
        if (_cfg == null) return;

        _logLevel = Str(_cfg, "logLevel", "basic");
        _weaponFallback = Bool(_cfg, "weaponFallback", true);
        _sainPresetInject = Bool(_cfg, "sainPresetInject", true);

        var rot = Obj(_cfg, "rotation");
        _rotEnabled = Bool(rot, "enabled", true);
        _rotMode = Str(rot, "mode", "random");
        _rotDays = Num(rot, "intervalDays", 7);
        _rotCount = Num(rot, "count", 1);
        _rebaseHour = Num(rot, "slotRebaseHour", 4);
        _seed = Num(rot, "seed", 0);
        _onlyGap = Bool(rot, "onlyWhenNoSeasonal", true);
        _excluded = new HashSet<string>(
            (rot?["exclude"] as JsonArray)?.Select(x => x?.ToString()).Where(s => !string.IsNullOrWhiteSpace(s)) ?? Enumerable.Empty<string>(),
            StringComparer.OrdinalIgnoreCase);

        var rr = Obj(_cfg, "rewardRotation");
        _rewardEnabled = Bool(rr, "enabled", true);
        _rewardMin = Num(rr, "countMin", 1);
        _rewardMax = Num(rr, "countMax", 2);
        _rewardAvoid = Bool(rr, "avoidConflicts", true);

        var sr = Obj(_cfg, "seasonRotation");
        _seasonMode = Str(sr, "mode", "rotate");
        _seasonDays = Num(sr, "intervalDays", 30);
        _seasonOffset = Num(sr, "offset", 0);
        _season = Str(sr, "season", "WINTER");
        _phase = Str(sr, "eventPhase", "start");
        _takeoverVanilla = Bool(_cfg, "vanillaSeasonTakeover", true);
        // ★ 第 26 项：独立天气开关（嵌套对象 weather.*；缺省 false = 不干预）
        var wx = Obj(_cfg, "weather");
        _suppressRainSnow = Bool(wx, "suppressRainSnow", false);
        _suppressFog = Bool(wx, "suppressFog", false);
        // ★★★ v2.7.0【硬开关】不启用任何活动（顶层 bool；缺省 false = 正常轮换）
        _disableAllEvents = Bool(_cfg, "disableAllEvents", false);
        // ★ 第 23 项：日期窗规则（白名单枚举；读到非法/缺失值一律回落默认 seasonOffOnly）
        _dateWindowRule = Str(_cfg, "dateWindowRule", "seasonOffOnly");
        if (_dateWindowRule != "always" && _dateWindowRule != "seasonOffOnly") _dateWindowRule = "seasonOffOnly";

        if (string.IsNullOrEmpty(_activeCat) && _groups.Any()) _activeCat = _groups.First().Key;
        _baseline = Snapshot();
    }

    private void ResetAll()
    {
        Reload();
        Snackbar.Add(L("已撤销未保存的改动", "Unsaved changes discarded"), Severity.Info);
