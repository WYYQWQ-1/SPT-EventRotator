    /// <summary>
    /// 日期窗倒计时（纯前端按本地今天算）：距开始 N 天 / 进行中，还剩 N 天 / 已结束。
    /// <para>events.json 里的月份日期**没有年份**（按年循环）⇒ 跨年窗口（例如 12/13–1/2）要把结束年 +1；
    /// 年初时上一年那份可能还在进行中，所以先试「去年那份」，不命中再看「今年那份」。
    /// 「还剩」按**含今天**算（窗口最后一天 = 还剩 1 天）。取不到合法日期就返回空串（这一项不显示）。</para>
    /// </summary>
    private string CountdownText(ConfigWebService.EventRow e)
    {
        try
        {
            if (e == null || e.StartDay <= 0 || e.StartMonth <= 0 || e.EndDay <= 0 || e.EndMonth <= 0) return "";
            var today = DateTime.Today;
            bool wraps = e.EndMonth < e.StartMonth || (e.EndMonth == e.StartMonth && e.EndDay < e.StartDay);

            DateTime StartAt(int y) => new DateTime(y, e.StartMonth, e.StartDay);
            DateTime EndAt(int y) => new DateTime(wraps ? y + 1 : y, e.EndMonth, e.EndDay);

            var s = StartAt(today.Year);
            var t = EndAt(today.Year);
            var ps = StartAt(today.Year - 1);
            var pt = EndAt(today.Year - 1);
            if (today <= pt) { s = ps; t = pt; }        // 年初还在上一年那份窗口里

            if (today < s) return L($"距开始 {(s - today).Days} 天", $"starts in {(s - today).Days} d");
            if (today <= t) return L($"进行中，还剩 {(t - today).Days + 1} 天", $"running, {(t - today).Days + 1} d left");
            return L("已结束", "ended");
        }
        catch { return ""; }
    }

    /// <summary>服务端快照里「当前实际生效」的活动 id（带缓存：快照原文变了才重解析）。</summary>
    private HashSet<string> _activeIds = new(StringComparer.OrdinalIgnoreCase);
    private string _activeIdsKey;

    /// <summary>
    /// 解析 StatusText 的机器可读行拿到当前生效 id：
    /// <c>#事件|分类|中文名|英文名|id|说明|英文说明</c>（第 5 列）与 <c>#手动|强制id|生效id列表</c>。
    /// 注意：StatusText 是**服务端快照**（写 当前生效活动.txt 的同一份文本），所以这里就是"正在跑的活动"。
    /// </summary>
    private HashSet<string> ActiveEventIds()
    {
        var status = CfgSvc.StatusText ?? "";
        if (string.Equals(_activeIdsKey, status, StringComparison.Ordinal)) return _activeIds;
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        try
        {
            foreach (var raw in status.Split('\n'))
            {
                var line = raw.Trim();
                if (line.StartsWith("#事件|", StringComparison.Ordinal))
                {
                    var parts = line.Split('|');
                    if (parts.Length > 4 && parts[4].Trim().Length > 0) set.Add(parts[4].Trim());
                }
                else if (line.StartsWith("#手动|", StringComparison.Ordinal))
                {
                    foreach (var seg in line.Substring("#手动|".Length).Split('|'))
                        foreach (var id in seg.Split(new[] { ',', ';', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries))
                            if (id.Trim().Length > 0) set.Add(id.Trim());
                }
            }
        }
        catch { }
        _activeIds = set;
        _activeIdsKey = status;
        return set;
    }

    /// <summary>这个活动现在算不算「已勾选 / 已生效」：手动强制（force.txt，还没套用也算）+ 服务端快照里正在跑的。</summary>
    private bool IsCheckedOrActive(string id)
        => !string.IsNullOrEmpty(id)
           && (_forceIds.Contains(id, StringComparer.OrdinalIgnoreCase) || ActiveEventIds().Contains(id));

    /// <summary>本行要提示的冲突：<c>ConflictsWith</c> 里当前「已勾选 / 已生效」的那些（名字用现有活动列表现查）。</summary>
    private List<ConflictInfo> ConflictsOf(ConfigWebService.EventRow e)
    {
        var res = new List<ConflictInfo>();
        try
        {
            if (e?.ConflictsWith == null || e.ConflictsWith.Count == 0) return res;
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var rawId in e.ConflictsWith)
            {
                var cid = (rawId ?? "").Trim();
                if (cid.Length == 0 || !seen.Add(cid)) continue;
                if (!IsCheckedOrActive(cid)) continue;
                var name = EventDisplayName(cid);
                res.Add(new ConflictInfo(cid, name,
                    L($"与 {name}（{cid}）的效果范围重叠，同时开启可能互相覆盖。",
                      $"Overlaps {name} ({cid}); enabling both may overwrite each other.")));
            }
        }
        catch { }
        return res;
    }

    /// <summary>按当前界面语言取活动显示名（查不到就用 id 兜底）。</summary>
    private string EventDisplayName(string id)
    {
        try
        {
            var row = _events.FirstOrDefault(x => string.Equals(x?.Id, id, StringComparison.OrdinalIgnoreCase));
            if (row == null) return id;
            if (!_zh) return string.IsNullOrEmpty(row.En) ? (string.IsNullOrEmpty(row.Zh) ? id : row.Zh) : row.En;
            return string.IsNullOrEmpty(row.Zh) ? id : row.Zh;
        }
        catch { return id; }
    }

    // ══════════ ★ B 线（契约 v3 · 进图预览）渲染辅助 ══════════

    /// <summary>地图下拉的绑定属性：换图就重建预览（只在用户选图时被 set）。</summary>
    private string PreviewMap
    {
        get => _previewMap;
        set
        {
            var v = string.IsNullOrWhiteSpace(value) ? "bigmap" : value;
            if (string.Equals(_previewMap, v, StringComparison.Ordinal)) return;
            _previewMap = v;
            BuildPreviewForMap();
        }
    }

    /// <summary>展开 / 收起。展开时重建一次；收起不做任何调用 ⇒ 关着的时候零开销、零 I/O。</summary>
    private void TogglePreview()
    {
        _previewOpen = !_previewOpen;
        if (_previewOpen) BuildPreviewForMap();
    }

    /// <summary>
    /// 调服务端只读推导（契约 v3：<c>ConfigWebService.BuildPreview(mapId)</c>）。
    /// <para>只读：不写配置、不写 force.txt、不触发任何 dimension 的 Apply；异常只在本面板里提示，不往上抛。</para>
    /// </summary>
    private void BuildPreviewForMap()
    {
        _previewError = "";
        try { _preview = CfgSvc.BuildPreview(_previewMap); }
        catch (Exception ex) { _preview = null; _previewError = ex.Message; }
    }

    /// <summary>按契约 v3 的固定顺序排分组：空分组丢掉；契约外的未知分组按服务端返回顺序垫后。</summary>
    private List<ConfigWebService.PreviewGroup> OrderedPreviewGroups()
    {
        var res = new List<ConfigWebService.PreviewGroup>();
        var src = _preview?.Groups;
        if (src == null) return res;
        var used = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in _previewOrder)
        {
            var g = src.FirstOrDefault(x => x != null && string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
            if (g == null || !used.Add(key)) continue;
            if (g.Items != null && g.Items.Count > 0) res.Add(g);
        }
        foreach (var g in src)
        {
            if (g == null) continue;
            if (!used.Add(g.Key ?? "")) continue;
            if (g.Items != null && g.Items.Count > 0) res.Add(g);
        }
        return res;
    }

    /// <summary>分组标题：按 Key 查本页的中英表；未知分组回退服务端 Title，再回退 Key。</summary>
    private string PreviewTitle(string key, string fallbackTitle)
    {
        var k = (key ?? "").Trim().ToLowerInvariant();
        if (k.Length > 0 && _previewTitles.TryGetValue(k, out var t)) return L(t.zh, t.en);
        if (!string.IsNullOrEmpty(fallbackTitle)) return fallbackTitle;
        return k;
    }

    /// <summary>「来自 X」：优先服务端 FromName；英文界面优先用活动表里的英文名；最后回退活动 id。</summary>
    private string FromLabel(string from, string fromName)
    {
        var id = (from ?? "").Trim();
        var name = (fromName ?? "").Trim();
        if (!_zh && id.Length > 0)
        {
            var en = EventDisplayName(id);
            if (!string.IsNullOrEmpty(en) && !string.Equals(en, id, StringComparison.OrdinalIgnoreCase)) name = en;
        }
        if (name.Length == 0) name = id;
        return name.Length == 0 ? "" : L($"来自 {name}", $"from {name}");
    }

    // ══════════ ★ 第 17 + 20 项：任务链展开 / 兼容性提示（纯渲染，无网络请求，不进 Snapshot） ══════════
    //  数据来自 ConfigWeb.EventRow 的新字段（另一条线实现，契约见任务说明）：
    //    List<QuestInfo> Quests · string QuestSummary · List<CompatNote> Compat
    //  这一整段只负责**显示**：不改 Save/Reload/Snapshot，过滤状态也不进 config（_expandedRows 只是本组件内存）。

    /// <summary>点标题展开 / 收起这一行的任务链 + 兼容提示（多行可同时展开；默认全收起）。</summary>
    private void ToggleRow(string id)
    {
        var key = (id ?? "").Trim();
        if (key.Length == 0) return;
        if (!_expandedRows.Add(key)) _expandedRows.Remove(key);
    }

    /// <summary>折叠标题：有任务链时是「任务链（summary）」，否则是「其它 mod 的兼容提示（N 条）」。</summary>
    private string RowToggleTitle(ConfigWebService.EventRow e, int chainTotal, int chainMissing, int compatCount)
    {
        if (chainTotal > 0)
        {
            if (_zh)
            {
                // 中文优先用服务端给的 QuestSummary；为空则自己按条数/缺失数兜底
                var s = (e?.QuestSummary ?? "").Trim();
                if (s.Length == 0) s = chainMissing > 0 ? $"{chainTotal} 条 · 本机缺 {chainMissing} 条" : $"{chainTotal} 条";
                return $"任务链（{s}）";
            }
            return chainMissing > 0
                ? $"Quest chain ({chainTotal} quests, {chainMissing} missing locally)"
                : $"Quest chain ({chainTotal} quests)";
        }
        return _zh ? $"其它 mod 的兼容提示（{compatCount} 条）" : $"Compat notes ({compatCount})";
    }

    /// <summary>活动行里显示的任务名（跟随界面语言；查不到名字就回退 id）。</summary>
    private string QuestDisplayName(ConfigWebService.EventRow.QuestInfo q)
    {
        if (q == null) return "";
        var zh = (q.NameZh ?? "").Trim();
        var en = (q.NameEn ?? "").Trim();
        var id = (q.Id ?? "").Trim();
        if (_zh) return zh.Length > 0 ? zh : (en.Length > 0 ? en : id);
        return en.Length > 0 ? en : (zh.Length > 0 ? zh : id);
    }

    /// <summary>
    /// 把 <c>Quests</c> 按 <c>PreviousId</c> 串成一条链（只在**展开时**才调用）。
    /// <para>容错（都是"绝不丢条目、绝不死循环"）：</para>
    /// <list type="bullet">
    /// <item><b>断链</b>（PreviousId 指向列表里不存在的 id）⇒ 该条不算 child、当根处理，链从它开始接。</item>
    /// <item><b>多个根</b>（新手链 / 前置缺失 / 自引用）⇒ 按 Quests 原顺序逐个当根走，各段顺序拼接。</item>
    /// <item><b>循环引用</b> ⇒ visited 集合 + 步数上限双保险，走到重复 id 立即停；环里剩下的条目最后按原顺序补在末尾。</item>
    /// <item><b>分叉</b>（两条的 PreviousId 相同）⇒ 先到先接，另一条由末尾兜底补上。</item>
    /// </list>
    /// </summary>
    private List<ConfigWebService.EventRow.QuestInfo> QuestChainOf(ConfigWebService.EventRow e)
    {
        var src = e?.Quests;
        var ordered = new List<ConfigWebService.EventRow.QuestInfo>();
        if (src == null || src.Count == 0) return ordered;

        var byId = new Dictionary<string, ConfigWebService.EventRow.QuestInfo>(StringComparer.OrdinalIgnoreCase);
        foreach (var q in src)
        {
            if (q == null) continue;
            ordered.Add(q);                                  // 原顺序（兜底补尾巴用）
            var id = (q.Id ?? "").Trim();
            if (id.Length > 0 && !byId.ContainsKey(id)) byId[id] = q;
        }
        if (ordered.Count == 0) return ordered;

        var next = new Dictionary<string, ConfigWebService.EventRow.QuestInfo>(StringComparer.OrdinalIgnoreCase);
        var isChild = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var q in ordered)
        {
            var id = (q.Id ?? "").Trim();
            var prev = (q.PreviousId ?? "").Trim();
            if (id.Length == 0 || prev.Length == 0) continue;
            if (string.Equals(prev, id, StringComparison.OrdinalIgnoreCase)) continue;   // 自引用 ⇒ 当根，不当 child
            if (!byId.ContainsKey(prev)) continue;                                       // 断链 ⇒ 当根
            if (!next.ContainsKey(prev)) next[prev] = q;                                 // 分叉 ⇒ 先到先接
            isChild.Add(id);
        }

        var roots = new List<ConfigWebService.EventRow.QuestInfo>();
        foreach (var q in ordered)
        {
            var id = (q.Id ?? "").Trim();
            if (id.Length == 0 || !isChild.Contains(id)) roots.Add(q);
        }
        if (roots.Count == 0) roots.Add(ordered[0]);          // 全成环 ⇒ 从第一条开始，靠 visited 收尾

        var result = new List<ConfigWebService.EventRow.QuestInfo>(ordered.Count);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var root in roots)
        {
            var cur = root;
            var guard = 0;
            while (cur != null && guard++ <= ordered.Count)
            {
                var id = (cur.Id ?? "").Trim();
                if (id.Length > 0 && !visited.Add(id)) break;                     // 环 / 重复 ⇒ 停
                result.Add(cur);
                cur = (id.Length > 0 && next.TryGetValue(id, out var nx)) ? nx : null;
            }
        }
        // 兜底：环外没走到的（分叉的败者）/ 无 id 的，按原顺序补在末尾 —— 保证一条都不丢
        //（纯环的情况：上面那次 walk 会先把环上每条各收一次，再在回到起点时 break，所以这里不用再接环。）
        foreach (var q in ordered)
        {
            if (result.Contains(q)) continue;
            var id = (q.Id ?? "").Trim();
            if (id.Length > 0 && !visited.Add(id)) continue;
            result.Add(q);
        }
        return result;
    }

    /// <summary>
    /// 第 20 项：兼容性提示的过滤 —— <c>Map == "*"</c>（或空）永远显示；
    /// 其余只有「当前地图筛选 = 全部」或「正好是选中的那张图」时才显示。
    /// </summary>
    private List<ConfigWebService.EventRow.CompatNote> CompatForMap(ConfigWebService.EventRow e)
    {
        var res = new List<ConfigWebService.EventRow.CompatNote>();
        var notes = e?.Compat;
        if (notes == null || notes.Count == 0) return res;
        var want = _mapFilter ?? "all";
        var filtering = !string.Equals(want, "all", StringComparison.Ordinal);
        foreach (var n in notes)
        {
            if (n == null) continue;
            var m = (n.Map ?? "").Trim();
            var isGlobal = m.Length == 0 || m == "*";
            if (!isGlobal && filtering && !string.Equals(m, want, StringComparison.OrdinalIgnoreCase)) continue;
            res.Add(n);
        }
        return res;
    }

    private async Task SaveAsync()
    {
        // 没有未保存改动 ⇒ 不写盘（避免每次点都生成一份备份），只重读 force + 重算活动
        if (ChangedCount == 0)
        {
            Snackbar.Add(CfgSvc.Reapply(), Severity.Success);
            _forceIds = CfgSvc.ReadForce();
            _forceConflicts = CfgSvc.ForceConflicts();
            _chips = BuildChips(CfgSvc.StatusText);
            StateHasChanged();
            await Task.CompletedTask;
            return;
        }

        var patch = new JsonObject
        {
            // ★★★ v2.7.0【硬开关】不启用任何活动（ConfigWeb.BoolKeys 白名单 + EventEngine.LoadConfig 读取点，
            //   三处键名逐字一致 = `disableAllEvents`）。保存后 ReloadSettingsFromDisk 检测到状态翻转
            //   ⇒ 立刻做一次「完整还原 + 按新状态套用」，不用重启服务端。
            ["disableAllEvents"] = _disableAllEvents,
            ["logLevel"] = _logLevel,
            ["weaponFallback"] = _weaponFallback,
            ["sainPresetInject"] = _sainPresetInject,
            ["rotation.enabled"] = _rotEnabled,
            ["rotation.mode"] = _rotMode,
            ["rotation.intervalDays"] = _rotDays,
            ["rotation.count"] = _rotCount,
            ["rotation.slotRebaseHour"] = _rebaseHour,
            ["rotation.seed"] = _seed,
            ["rotation.onlyWhenNoSeasonal"] = _onlyGap,
            ["rewardRotation.enabled"] = _rewardEnabled,
            ["rewardRotation.countMin"] = _rewardMin,
            ["rewardRotation.countMax"] = _rewardMax,
            ["rewardRotation.avoidConflicts"] = _rewardAvoid,
            ["seasonRotation.mode"] = _seasonMode,
            ["seasonRotation.intervalDays"] = _seasonDays,
            ["seasonRotation.offset"] = _seasonOffset,
            ["seasonRotation.season"] = _season,
            ["seasonRotation.eventPhase"] = _phase,
            // ★ 2026-10-29【第 25 项 · 接管原版季节窗】键名与 `ConfigWeb.BoolKeys` 白名单、
            //   以及 `Plugin.ApplyVanillaSeasonTakeover` 的读取点三者**逐字一致** = `vanillaSeasonTakeover`。
            //   ⚠ 之前只进了 Snapshot()（所以能显示"未保存改动 1 项"），patch 里没有它 ⇒ 点了保存也写不进去。
            ["vanillaSeasonTakeover"] = _takeoverVanilla,
            // ★ 第 26 项：独立天气开关（ConfigWeb.BoolKeys 白名单；服务端 WeatherSuppressPatch 热读，
            //   进下一局即生效、**不需要重启**，所以不在 RestartRequiredKeys 里）
            ["weather.suppressRainSnow"] = _suppressRainSnow,
            ["weather.suppressFog"] = _suppressFog,
            // ★ 第 23 项：日期窗规则（ConfigWeb.EnumKeys 白名单：seasonOffOnly | always）
            ["dateWindowRule"] = _dateWindowRule,
        };
        var arr = new JsonArray();
        foreach (var id in _excluded.OrderBy(x => x, StringComparer.OrdinalIgnoreCase)) arr.Add(id);
        patch["rotation.exclude"] = arr;

        var (ok, msg) = CfgSvc.Save(patch);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        Reload();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void RestoreSelected()
    {
        var (ok, msg) = CfgSvc.Restore(_selectedBackup);
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
        Reload();
        StateHasChanged();
    }

    private string CatName(string cat) => cat switch
    {
        "event_ai" => L("AI 活动", "AI events"),
        "event_small" => L("小活动", "Small events"),
        "event_task" => L("带任务", "With quests"),
        "reward" => L("奖励活动", "Reward events"),
        "seasonal" => L("季节活动", "Seasonal events"),
        _ => cat,
    };

    private string ChipLabel(string kind) => kind switch
    {
        "slot" => L("档位", "Slot"),
        "start" => L("本档开始", "Slot starts"),
        "next" => L("下次换档", "Next slot"),
        "active" => L("当前活动", "Active"),
        _ => kind,
    };

    private List<(string kind, string value, bool warn)> BuildChips(string status)
    {
        var chips = new List<(string, string, bool)>();
        try
        {
            foreach (var line in (status ?? "").Split('\n'))
            {
                var t = line.Trim();
                if (t.Length == 0) continue;

                if (t.StartsWith("档位:"))
                {
                    var v = t.Substring(3).Trim();
                    var cut = v.IndexOf('（');
                    var slot = cut > 0 ? v.Substring(0, cut).Trim() : v;
                    chips.Add(("slot", slot + L($"（每 {_rotDays} 天换一档，基准 {_rebaseHour}:00）", $" ({_rotDays}d per slot, rebase {_rebaseHour}:00)"), false));
                }
                else if (t.StartsWith("本档开始:"))
                    chips.Add(("start", t.Substring(5).Trim(), false));
                else if (t.StartsWith("下次换档:"))
                    chips.Add(("next", t.Substring(5).Trim(), false));
                else if (t.StartsWith("当前活动") || t.StartsWith("生效活动"))
                    chips.Add(("active", t[(t.IndexOf(':') + 1)..].Trim(), true));

                if (chips.Count >= 4) break;
            }
        }
        catch { }
        return chips;
    }

    private static JsonObject Obj(JsonObject root, string key) => root?[key] as JsonObject;

    private static string Str(JsonObject root, string key, string dflt)
    {
        try { return root?[key]?.ToString() ?? dflt; } catch { return dflt; }
    }

    private static bool Bool(JsonObject root, string key, bool dflt)
    {
        try
        {
            var t = root?[key]?.ToJsonString()?.Trim();
            if (string.Equals(t, "true", StringComparison.OrdinalIgnoreCase)) return true;
            if (string.Equals(t, "false", StringComparison.OrdinalIgnoreCase)) return false;
        }
        catch { }
        return dflt;
    }

    private static int Num(JsonObject root, string key, int dflt)
    {
        try
        {
            var t = root?[key]?.ToJsonString()?.Trim();
            if (double.TryParse(t, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d)) return (int)d;
        }
        catch { }
        return dflt;
    }
