    /// <summary>★ v1.3.9【防假成功】比对"我强制了什么"和"服务端认为当前是什么"。</summary>
    private void RefreshForceState()
    {
        _forceIds = CfgSvc.ReadForce();
        _forceConflicts = CfgSvc.ForceConflicts();

        // ★ v1.3.9【误报修复】活动表可能是空的（页面在服务端刚启动时加载过一次）——
        //   那种情况下比对必然"全都不认识"，于是合法 id 也被标成不存在。这里：
        //   ① 本地快照为空就现场重新读一次 ② 仍然为空则跳过这项检查（服务端会自己报）。
        var rows = _events;
        if (rows.Count == 0)
        {
            rows = CfgSvc.ListEvents();
            if (rows.Count > 0) _events = rows;
        }
        if (rows.Count > 0)
        {
            var known = new HashSet<string>(rows.Select(e => e.Id), StringComparer.OrdinalIgnoreCase);
            _forceUnknown = _forceIds.Where(x => !known.Contains(x) && !string.Equals(x, "none", StringComparison.OrdinalIgnoreCase)).ToList();
        }
        else _forceUnknown.Clear();

        var status = CfgSvc.StatusText ?? "";
        _forceNotApplied = _forceIds.Count > 0 && status.Contains("来源: 自动");
    }

    private void ToggleExclude(string id, bool on)
