<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ProbeDisableAll</AssemblyName>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0168;CS8509</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProbeDisableAll.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- SPT 的类型表扫描需要 Hosting.Abstractions 等 ASP.NET 共享框架程序集 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SPT 运行时全部 dll 拷到输出（只读拷贝，不动部署） -->
  <ItemGroup>
    <ProbeRuntimeFiles Include="D:\PureEFTv4.1\EFTv4.1\SPT_Runtime\*.dll" />
  </ItemGroup>

  <Target Name="CopyProbeRuntime" AfterTargets="Build">
    <Copy SourceFiles="@(ProbeRuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
