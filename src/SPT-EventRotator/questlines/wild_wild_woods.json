   "63fc44e2429a8a166c7f61e6 Name": "Armasight Zeus-Pro 640 2-8x50 30Hz热成像瞄准镜",
   "63fc44e2429a8a166c7f61e6 ShortName": "ZeusPro 640",
   "63fc44e2429a8a166c7f61e6 Description": "Zeus-Pro 640 热成像瞄准镜具备 2-8 倍变倍功能，由 Armasight 设计制造。",
   "627e14b21713922ded6f2c15 Name": "Accuracy International AXMC .338 LM 栓动式狙击步枪",
   "627e14b21713922ded6f2c15 ShortName": "AXMC",
   "627e14b21713922ded6f2c15 Description": "AXMC 是英国精准国际打造的最新一代栓动式狙击步枪，融合了前代装备的大量设计经验，并结合实战教训进行改良。.338 Lapua Magnum 口径，通过更换枪管、枪机套件以及弹匣井机构也可快速转换为发射 .300 温彻斯特 Magnum 与 .308 温彻斯特口径弹药。",
   "6769b8e3c1a1466c850658a8 Name": "7.62x51mm M80A1 弹药包（20发装）",
   "6769b8e3c1a1466c850658a8 ShortName": "M80A1",
   "6769b8e3c1a1466c850658a8 Description": "一盒7.62x51mm M80A1弹药，20发装。",
   "657023ccbfc87b3a3409320a Name": ".338 Lapua Magnum FMJ弹药包（20发装）",
   "657023ccbfc87b3a3409320a ShortName": "FMJ",
   "657023ccbfc87b3a3409320a Description": "一盒20发装的.338 Lapua Magnum FMJ弹。",
   "5c0126f40db834002a125382 Name": "Red Rebel冰镐",
   "5c0126f40db834002a125382 ShortName": "RedRebel",
   "5c0126f40db834002a125382 Description": "完美平衡的冰镐，顶端由一块高硬度金属制成。",
   "5780cf7f2459777de4559322 Name": "宿舍楼 314 房间符号钥匙",
   "5780cf7f2459777de4559322 ShortName": "314钥匙",
   "5780cf7f2459777de4559322 Description": "宿舍楼 314 房间钥匙，原本标有房间号的地方刻满了奇怪的符号。这把钥匙锈蚀得很厉害，至多再使用几次就会断掉。",
   "588892092459774ac91d4b11 Name": "DVL-10 7.62x51 栓动式狙击步枪",
   "588892092459774ac91d4b11 ShortName": "DVL-10",
   "588892092459774ac91d4b11 Description": "DVL-10是一款集轻便，紧凑和消音于一体的步枪。使用具有优异精度和射程，以满足特勤和作战任务需要的军用亚音速子弹。配备有标准Lobaev可折叠枪托和Lobaev Hummer Barrels不锈钢竞赛级枪管。",
   "5888988e24597752fe43a6fa Name": "DVL-10 7.62x51 10发弹匣",
   "5888988e24597752fe43a6fa ShortName": "DVL-10",
   "5888988e24597752fe43a6fa Description": "LOBAEV Arms生产的标准DVL-10狙击步枪弹匣，适用于.308口径的子弹。",
   "5888956924597752983e182d Name": "DVL-10 M2 7.62x51 660 毫米枪管",
   "5888956924597752983e182d ShortName": "DVL-10 M2 660mm",
   "5888956924597752983e182d Description": "LOBAEV Hummer Barrels 为 DVL-10 M2 Urbana 制造的 7.62x51 口径竞赛级不锈钢枪管，长度 660 毫米。",
   "5888996c24597754281f9419 Name": "DVL-10 M2 7.62x51膛口制退器",
   "5888996c24597754281f9419 ShortName": "DVL-10 M2制退器",
   "5888996c24597754281f9419 Description": "DVL-10 M2狙击步枪的标准膛口制退器。",
   "5888976c24597754281f93f5 Name": "LOBAEV Arms DVL-10 M2护木",
   "5888976c24597754281f93f5 ShortName": "DVL-10 M2",
   "5888976c24597754281f93f5 Description": "DVL-10 M2狙击枪的标准LOBAEV Arms护木。",
   "57c55f172459772d27602381 Name": "Hogue OverMolded 橡胶握把（橄榄绿）",
   "57c55f172459772d27602381 ShortName": "OMRG OD",
   "57c55f172459772d27602381 Description": "由玻璃纤维以及橡胶包覆成型的防滑手枪式握把，AR 武器系统专用，由 Hogue 制造。橄榄绿色版本。",
   "58889d0c2459775bc215d981 Name": "LOBAEV Arms枪托",
