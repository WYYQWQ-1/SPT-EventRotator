<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SPT-EventRotator.Client</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0108;CS0114;CS0169;CS0649;CS0162;CS0414;CS8618;CS8632;CS0168</NoWarn>
  </PropertyGroup>
  <!-- ★★★ bossScourge：Patcher/ 是**独立**的 BepInEx preloader patcher 工程
       （输出 SPT-EventRotator.Patcher.dll → BepInEx\patchers\）。它引用 Mono.Cecil，
       不能混进本插件工程（默认 glob 会把它编译进来 ⇒ 插件多出 Mono.Cecil 依赖）。 -->
  <ItemGroup>
    <Compile Remove="Patcher/**/*.cs" />
  </ItemGroup>
